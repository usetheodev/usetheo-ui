{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["@testing-library/jest-dom"],
    "declaration": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@theokit/ui": ["./src/index.ts"],
      "@theokit/ui/whiteboard": ["./src/components/primitives/whiteboard/index.ts"],
      "@theokit/ui/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    ".ladle/**/*",
    "vitest.config.ts",
    "tsup.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": ["node_modules", "dist", "playground", "playground/dist"]
}
