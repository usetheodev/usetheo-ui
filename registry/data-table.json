{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "data-table",
  "type": "registry:ui",
  "title": "DataTable",
  "description": "Generic, sortable, expandable composite over <Table>. Operator-grade entity-list patterns: sortable headers (controlled OR uncontrolled), sticky header, expandable rows (multi default + expandMode='single' opt-in), row action menus via DropdownMenu, client-side pagination, loading skeleton, empty state. Generic over T (e.g. DataTable<Domain>). Virtualized mode (10K+ rows over @tanstack/react-virtual): fixed row heights, sticky header, mutually exclusive with pagination/expandable at the type level.",
  "dependencies": [
    "lucide-react",
    "@tanstack/react-virtual"
  ],
  "registryDependencies": [
    "cn",
    "env",
    "table",
    "pagination",
    "skeleton",
    "empty-state",
    "dropdown-menu",
    "tailwind-preset"
  ],
  "files": [
    {
      "path": "components/composites/data-table/data-table.tsx",
      "type": "registry:ui",
      "target": "components/ui/data-table.tsx"
    },
    {
      "path": "components/composites/data-table/data-table-virtualized.tsx",
      "type": "registry:ui",
      "target": "components/ui/data-table-virtualized.tsx"
    },
    {
      "path": "components/composites/data-table/data-table-parts.tsx",
      "type": "registry:ui",
      "target": "components/ui/data-table-parts.tsx"
    },
    {
      "path": "components/composites/data-table/data-table-loading.tsx",
      "type": "registry:ui",
      "target": "components/ui/data-table-loading.tsx"
    },
    {
      "path": "components/composites/data-table/use-data-table-sort.ts",
      "type": "registry:ui",
      "target": "components/ui/use-data-table-sort.ts"
    },
    {
      "path": "components/composites/data-table/compare-values.ts",
      "type": "registry:ui",
      "target": "components/ui/compare-values.ts"
    }
  ]
}
